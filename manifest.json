{
  "manifest_version": 3,
  "name": "Auto Language Fixer",
  "version": "1.2",
  "description": "Fix Thai/English wrong-keyboard-layout typing with a shortcut (Thai to English and English to Thai).",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fix-language": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Convert Thai/English typing (selection or mode from settings)"
    },
    "fix-language-all": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Convert the whole text field"
    }
  }
}